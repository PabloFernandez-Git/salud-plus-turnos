# App (local, non-secret)
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Set true on the independent public DEMO deployment; blocks server writes.
PORTFOLIO_DEMO_MODE=false
# Keep false until the DEMO-only Auth and SQL activation checklist passes.
PORTFOLIO_GUEST_ACCESS_ENABLED=false
# Set true only when Supabase Auth CAPTCHA is enabled for DEMO.
PORTFOLIO_GUEST_CAPTCHA_REQUIRED=false
# Optional Turnstile site key; configure Supabase Auth CAPTCHA before setting it.
NEXT_PUBLIC_PORTFOLIO_TURNSTILE_SITE_KEY=

# Supabase public configuration (safe for the browser; RLS must still protect data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_DEV_PUBLISHABLE_KEY

# Supabase Auth Admin (server-only secret; configure only in .env.local/deploy secrets)
SUPABASE_SECRET_KEY=YOUR_DEV_SECRET_KEY

# Supabase DEV identity (local, non-secret)
SUPABASE_DEV_PROJECT_REF=YOUR_DEV_PROJECT_REF
